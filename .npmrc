# better-sqlite3 ships precompiled binaries for every platform in its own
# package (see node_modules/better-sqlite3/prebuilds after install) and does
# not need its install script to run. Skipping install scripts avoids an
# unnecessary native compilation step (and the node-gyp/Node-headers download
# it triggers) on machines or networks that don't need it — the package
# works immediately either way. If you add a different package later that
# genuinely needs its install script, run `npm rebuild <package>` for it
# specifically, or remove this line.
ignore-scripts=true
